<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../InstallerVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>FM27Access-Installer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FM27Access.Installer.Core/FM27Access.Installer.Core.csproj" />
    <EmbeddedResource Include="Resources/*.json" />
    <EmbeddedResource Include="../../docs/user/FM27Access-UserGuide.html" LogicalName="FM27Access.Installer.UserGuide.html" />
  </ItemGroup>
</Project>
