<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\tools\game-inspect\InstallationInspector.cs" Link="Platform\InstallationInspector.cs" />
    <EmbeddedResource Include="..\packaging\native-profiles.json" LogicalName="FM27Access.NativeProfiles.json" />
  </ItemGroup>

  <Target Name="GenerateModBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <ModBuildVersionFile>$(IntermediateOutputPath)ModBuildVersion.g.cs</ModBuildVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(ModBuildVersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="namespace FM27Access.Speech { public static partial class BuildProfile { public const string Version = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(ModBuildVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
